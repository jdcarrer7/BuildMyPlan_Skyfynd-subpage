{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "skyfynd-buildmyplan",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public vars only — safe to commit
  "vars": {
    "SUPABASE_URL": "https://supabase.skyfynd.io",
    "NEXT_PUBLIC_SUPABASE_URL": "https://supabase.skyfynd.io",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzczMDg2ODMwLCJleHAiOjE5MzA3NjY4MzB9.YgBG1VjN2nYSD0o4oIkUF6EslGZbZB1_m5kJ6WxZ9PY",
    "NEXT_PUBLIC_BASE_URL": "https://plans.skyfynd.io",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_51T0uep3s2LeYyAbKGAe90DsqxZJYUv1nY0Jb9F9FPnJmRtk9etSVHaDc4hin3N4iDH3XJZpwljS0nKUw4Rlc7rQM00nshqgYJx"
  }
  // All secrets must be set via: npx wrangler secret put <KEY_NAME>
  // Required secrets:
  //   SESSION_SECRET
  //   RESEND_API_KEY
  //   SUPABASE_SERVICE_ROLE_KEY  ← must be the VPS service-role key (supabase.skyfynd.io), not Supabase Cloud
  //   STRIPE_SECRET_KEY
  //   STRIPE_WEBHOOK_SECRET
}
